# Player application form
whitelist-application-form-title = Whitelist application
whitelist-application-form-description = Write why you would like to join the server. You can only apply once, so make it count.
whitelist-application-form-disabled = The whitelist is currently disabled on this server, so there is nothing to apply for.
whitelist-application-form-placeholder = I would like to join this station because...
whitelist-application-form-counter = {$current} / {$max} characters
whitelist-application-form-existing = Your application #{$id} is {$status}. You cannot submit another one.
whitelist-application-form-reviewer = Reviewed by {$reviewer}.
whitelist-application-form-reviewer-date = Reviewed by {$reviewer} on {$reviewed}.
whitelist-application-submit = Submit application

whitelist-application-reject-empty = You need to write a message for your application.
whitelist-application-reject-too-long = Your application is too long. The maximum is {$max} characters.
whitelist-application-reject-already-applied = You have already submitted a whitelist application.
whitelist-application-reject-failed = Your whitelist application could not be submitted.

# Screen shown while the whitelist blocks the player
whitelist-application-screen-title = Whitelist application required
whitelist-application-screen-description = This server only accepts whitelisted players. You are not on the whitelist yet, but you can still apply. Once you submit an application an admin will review it, and you will be able to join after it is approved.
whitelist-application-screen-pending = You already have a whitelist application waiting for review.
    You will be able to join once an admin approves it.
whitelist-application-screen-open = Write an application
whitelist-application-screen-disconnect = Disconnect
