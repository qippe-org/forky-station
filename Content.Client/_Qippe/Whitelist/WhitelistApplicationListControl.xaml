<controls:WhitelistApplicationListControl
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._Qippe.Whitelist">
    <PanelContainer StyleClasses="BackgroundDark">
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
            <Label Name="EmptyLabel" Access="Public" Visible="False" HorizontalAlignment="Center" />
            <ScrollContainer HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False">
                <BoxContainer Name="Applications" Access="Public" Orientation="Vertical" VerticalExpand="True">
                    <controls:WhitelistApplicationHeader />
                </BoxContainer>
            </ScrollContainer>
        </BoxContainer>
    </PanelContainer>
</controls:WhitelistApplicationListControl>




