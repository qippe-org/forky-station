<BoxContainer
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Orientation="Horizontal"
    HorizontalExpand="True"
    SeparationOverride="4">
    <Label Name="IdLabel"
           SizeFlagsStretchRatio="1"
           HorizontalExpand="True"
           ClipText="True" />
    <Label Name="PlayerLabel"
           SizeFlagsStretchRatio="3"
           HorizontalExpand="True"
           ClipText="True" />
    <Label Name="StatusLabel"
           SizeFlagsStretchRatio="2"
           HorizontalExpand="True"
           ClipText="True" />
    <Label Name="CreatedLabel"
           SizeFlagsStretchRatio="3"
           HorizontalExpand="True"
           ClipText="True" />
    <Label Name="ReviewerLabel"
           SizeFlagsStretchRatio="3"
           HorizontalExpand="True"
           ClipText="True" />
    <BoxContainer Orientation="Horizontal"
                  SizeFlagsStretchRatio="6"
                  HorizontalExpand="True"
                  SeparationOverride="4">
        <Button Name="ViewButton" Text="{Loc whitelist-application-view}" />
        <controls:ConfirmButton Name="ApproveButton" Text="{Loc whitelist-application-approve}" />
        <controls:ConfirmButton Name="DenyButton" Text="{Loc whitelist-application-deny}" />
    </BoxContainer>
</BoxContainer>
