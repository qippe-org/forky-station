<speechBubble:BaseSpeechBubble
    xmlns="https://spacestation14.io"
    xmlns:speechBubble="clr-namespace:Content.Client.Chat.SpeechBubble"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls">
    <PanelContainer Name="LabelPanel" StyleClasses="speechBox" VerticalAlignment="Bottom">
        <BoxContainer Orientation="Vertical" Align="Center">
            <RichTextLabel Name="NameLabel" Visible="False" Margin="2 2 2 2" HorizontalAlignment="Center" StyleClasses="bubbleContent fontChatName"/>
            <PanelContainer Name="NameDivider" Visible="False" StyleClasses="LowDivider" Margin="0 2.5 0 2.5" />
            <controls:AlignedRichTextLabel Name="Label" MaxWidth="256" Margin="2 4" HorizontalAlignment="Center" StyleClasses="bubbleContent fontChat"/>
        </BoxContainer>
    </PanelContainer>
</speechBubble:BaseSpeechBubble>